rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One document = one transfer row. Only logged-in shop accounts can use it.
    match /transfers/{transferId} {
      allow read, delete: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.id == transferId
        && request.resource.data.transactionType in ['deposit', 'withdraw']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.serviceFee is number
        && request.resource.data.serviceFee >= 0
        && request.resource.data.customerName is string
        && request.resource.data.dateTime is string;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
